@page
@model LoginModel

@{
    ViewData["Title"] = "Вход";
}

<div class="auth-page">

    <div class="auth-card">

        <form id="account"
              method="post"
              class="auth-form">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger auth-validation"
                 role="alert">
            </div>


            <div class="form-floating">

                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="name@example.com" />

                <label asp-for="Input.Email">
                    Имейл
                </label>

                <span asp-validation-for="Input.Email"
                      class="text-danger">
                </span>

            </div>


            <div class="form-floating">

                <input asp-for="Input.Password"
                       class="form-control"
                       autocomplete="current-password"
                       aria-required="true"
                       placeholder="Парола" />

                <label asp-for="Input.Password">
                    Парола
                </label>

                <span asp-validation-for="Input.Password"
                      class="text-danger">
                </span>

            </div>


            <div class="auth-remember">

                <input class="form-check-input"
                       asp-for="Input.RememberMe" />

                <label asp-for="Input.RememberMe">
                    Запомни ме
                </label>

            </div>


            <button id="login-submit"
                    type="submit"
                    class="auth-button">
                Вход
            </button>

        </form>


        <div class="auth-links">

            <p>
                <a id="forgot-password"
                   asp-page="./ForgotPassword">
                    Забравена парола?
                </a>
            </p>

            <p>
                Нямате акаунт?
                <a asp-page="./Register"
                   asp-route-returnUrl="@Model.ReturnUrl">
                    Регистрация
                </a>
            </p>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}