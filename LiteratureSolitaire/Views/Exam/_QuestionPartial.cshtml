@model LiteratureSolitaire.Core.Models.ExamQuestionViewModel

<div class="exam-question" data-question-id="@Model.Id">
    <p class="question-content">@Model.Content</p>

    <div class="answers-list">
        @{
            var letters = new[] { "А", "Б", "В", "Г" };
        }

        @for (int i = 0; i < Model.Answers.Count; i++)

        {

            var answer = Model.Answers[i];



            var cls = "answer-option";

            if (answer.IsSelected) cls += " selected";

            if (Model.IsChecked && answer.IsCorrect == true) cls += " correct";

            if (Model.IsChecked && answer.IsSelected && answer.IsCorrect == false) cls += " wrong";

            <label class="@cls" data-answer-id="@answer.Id">
                <input type="radio"
                       name="question-@Model.Id"
                       value="@answer.Id"
                @(answer.IsSelected ? "checked" : "")
                @(Model.IsChecked ? "disabled" : "") />
                <span>@letters[i]) @answer.Content</span>
            </label>
        }
    </div>
</div>